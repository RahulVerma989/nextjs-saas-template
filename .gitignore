# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# OG image cache (generated at runtime)
.cache/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated brand assets — re-created on every build from siteConfig
# by scripts/generate-brand-assets.ts.  Don't commit them.
/public/favicon.ico
/public/favicon.svg
/public/favicon-*.png
/public/apple-touch-icon.png
/public/android-chrome-*.png
/public/site.webmanifest
/public/.brand-version

# Generated page manifest (build-time hashes for GSC indexing)
/src/lib/data/page-manifest.json
