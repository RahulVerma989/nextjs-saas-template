# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth (NextAuth v5) ─────────────────────────────────────
AUTH_SECRET=              # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/saas_app
# Or use individual settings:
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_DATABASE=saas_app
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_POOL_SIZE=50

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Or use individual settings:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── Payments (Dodo Payments) ────────────────────────────────
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode        # test_mode or live_mode

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Your App <hello@yourdomain.com>
RESEND_REPLY_TO_EMAIL=support@yourdomain.com

# ─── File Storage (S3/R2) ───────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ─── Secrets Management (Infisical - optional) ──────────────
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=dev
# INFISICAL_WEBHOOK_SECRET=

# ─── Admin ───────────────────────────────────────────────────
# ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
